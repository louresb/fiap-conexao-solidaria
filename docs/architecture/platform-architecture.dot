digraph ConexaoSolidaria {
  graph [rankdir=TB, bgcolor="#F7F9F8", pad="0.35", nodesep="0.34", ranksep="0.58", splines=polyline, newrank=true, fontname="Arial", fontsize=18, labelloc="t", label="CONEXÃO SOLIDÁRIA  |  ARQUITETURA DA PLATAFORMA"];
  node [shape=rect, style="rounded,filled", color="#CAD5CF", fillcolor="#FFFFFF", fontname="Arial", fontcolor="#17211D", fontsize=10, margin="0.16,0.11"];
  edge [color="#75867D", fontname="Arial", fontcolor="#52615A", fontsize=8, arrowsize=0.68];

  personas [label="PÚBLICO  •  DOADOR  •  GESTOR ONG", fillcolor="#FFF4D2", color="#E8BC4B"];

  subgraph cluster_access {
    label="EXPERIÊNCIA, IDENTIDADE E BORDA";
    labeljust="l"; fontsize=14; margin=18;
    style="rounded,filled"; color="#BED3C9"; fillcolor="#EDF4F0"; fontcolor="#164B3C";
    web [label="BLAZOR WEB APP\nPortal público, doador e gestão"];
    gateway [label="YARP GATEWAY / BFF\nRoteamento • Rate limiting • JWT", fillcolor="#DDEEE7", color="#176B50"];
    keycloak [label="KEYCLOAK\nOIDC • RBAC • tenant_id", fillcolor="#E4ECF8", color="#4B6FA8"];
    { rank=same; web; gateway; keycloak; }
  }

  subgraph cluster_services {
    label="CAPACIDADES DE NEGÓCIO  |  .NET 10  |  DEPLOY INDEPENDENTE";
    labeljust="l"; fontsize=14; margin=18;
    style="rounded,filled"; color="#CFD8D3"; fillcolor="#FFFFFF"; fontcolor="#29352F";
    api_edge [shape=point, width=0.08, label="", fillcolor="#176B50", color="#176B50"];
    identity [label="IDENTITY API\nCadastro e perfil do doador"];
    campaigns [label="CAMPAIGNS API\nCampanhas • Transparência • Busca"];
    donations [label="DONATIONS API\nIntenção • Ledger • Idempotência"];
    payments [label="PAYMENTS API\nPix • Cartão • Boleto • Webhook"];
    campaign_worker [label="CAMPAIGNS WORKER\nProjeção assíncrona do total"];
    audit [label="AUDIT API / CONSUMER\nTrilha append-only correlacionada"];
    knowledge [label="KNOWLEDGE API\nRetrieval com fontes verificadas"];
    { rank=same; identity; campaigns; donations; payments; audit; knowledge; }
  }

  subgraph cluster_data {
    label="DADOS, EVENTOS E PROJEÇÕES";
    labeljust="l"; fontsize=14; margin=18;
    style="rounded,filled"; color="#D8D0BE"; fillcolor="#FBF8F1"; fontcolor="#544A34";
    postgres [label="POSTGRESQL\nBanco por capacidade • Outbox/Inbox", fillcolor="#E5EEF8", color="#4B6FA8"];
    redis [label="REDIS\nCache de leitura • Invalidação", fillcolor="#F8E2E1", color="#B9514C"];
    rabbit [label="RABBITMQ + MASSTRANSIT\nEventos • Retry • DLQ", fillcolor="#FCE8D8", color="#D77729"];
    search [label="OPENSEARCH\nÍndice de campanhas • Busca fuzzy", fillcolor="#E9E4F5", color="#7458A6"];
    mongo [label="MONGODB\nAuditoria append-only", fillcolor="#E5F1DF", color="#5E8D47"];
    corpus [label="CORPUS VERSIONADO\nDocumentos institucionais por tenant", fillcolor="#FFF4D2", color="#E8BC4B"];
    { rank=same; postgres; redis; rabbit; search; mongo; corpus; }
  }

  subgraph cluster_observability {
    label="OBSERVABILIDADE OPERACIONAL";
    labeljust="l"; fontsize=14; margin=18;
    style="rounded,filled"; color="#C9D5D9"; fillcolor="#EFF4F6"; fontcolor="#304D58";
    telemetry [label="SERILOG • CORRELATION ID • OPENTELEMETRY\nTenant e correlação em logs, métricas e traces"];
    collector [label="OTEL COLLECTOR + TEMPO\nPipeline OTLP e tracing distribuído", fillcolor="#E7EDF8", color="#4B6FA8"];
    ops [label="PROMETHEUS • GRAFANA • LOKI • ZABBIX\nMétricas, dashboards, logs e web scenarios", fillcolor="#E6F0F3", color="#477589"];
    { rank=same; telemetry; collector; ops; }
  }

  personas -> web [label="HTTPS"];
  web -> keycloak [label="OIDC"];
  web -> gateway;
  gateway -> keycloak [label="JWT"];
  gateway -> api_edge [arrowhead=none];
  api_edge -> identity;
  api_edge -> campaigns;
  api_edge -> donations;
  api_edge -> payments;
  api_edge -> audit;
  api_edge -> knowledge;

  identity -> postgres;
  identity -> keycloak [label="provisiona", style=dashed];
  campaigns -> postgres;
  campaigns -> redis;
  campaigns -> search;
  campaigns -> rabbit [label="Outbox"];
  donations -> campaigns [label="elegibilidade", style=dashed];
  donations -> postgres;
  donations -> rabbit [label="Outbox"];
  rabbit -> payments [label="intenção"];
  payments -> postgres;
  payments -> rabbit [label="confirmação"];
  rabbit -> donations [label="confirmação"];
  rabbit -> campaign_worker [label="doação processada"];
  campaign_worker -> postgres [label="projeção"];
  campaign_worker -> redis [label="invalida"];
  campaign_worker -> search [label="reindexa"];
  rabbit -> audit [label="fan-out"];
  audit -> mongo;
  knowledge -> corpus;
  knowledge -> rabbit [label="audita"];

  postgres -> telemetry [style=dashed, arrowhead=none];
  rabbit -> telemetry [style=dashed, arrowhead=none];
  telemetry -> collector [label="OTLP"];
  collector -> ops [label="traces"];
  telemetry -> ops [label="logs + métricas", constraint=false];
}
