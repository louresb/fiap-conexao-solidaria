{
  "uid": "conexao-solidaria-operacao",
  "title": "Conexão Solidária | Operação",
  "tags": ["conexao-solidaria", "cloud-native"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Componentes disponíveis",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 9 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(up{job=~\"gateway|web|.*-api|campaigns-worker\"})", "legendFormat": "serviços" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Doações processadas",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixedColor", "fixedColor": "green" } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(conexao_donations_processed_total{status=\"processed\"})", "legendFormat": "confirmadas" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mensagens aguardando",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rabbitmq_queue_messages_ready)", "legendFormat": "filas" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taxa de erros HTTP",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(http_requests_received_total{code=~\"5..\"}[2m]))", "legendFormat": "5xx" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requisições HTTP por serviço",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(http_requests_received_total[2m])) by (job)", "legendFormat": "{{job}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência HTTP p95",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[2m])) by (le, job))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tempo de processamento da doação",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(conexao_donation_processing_seconds_bucket[5m])) by (le, tenant))", "legendFormat": "{{tenant}}" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Profundidade das filas RabbitMQ",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rabbitmq_queue_messages_ready) by (queue)", "legendFormat": "{{queue}}" }]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU por serviço",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "cores" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(rate(process_cpu_seconds_total[2m])) by (job)", "legendFormat": "{{job}}" }]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memória por serviço",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "sum(process_working_set_bytes) by (job)", "legendFormat": "{{job}}" }]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Logs estruturados",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 9 },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "enableLogDetails": true },
      "targets": [{ "datasource": { "type": "loki", "uid": "Loki" }, "expr": "{level=~\".+\"}", "refId": "A" }]
    }
  ]
}
