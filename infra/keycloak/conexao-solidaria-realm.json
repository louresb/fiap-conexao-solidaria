{
  "realm": "conexao-solidaria",
  "displayName": "Conexao Solidaria",
  "displayNameHtml": "Conex&atilde;o Solid&aacute;ria",
  "enabled": true,
  "loginTheme": "conexao-solidaria",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "GestorONG", "description": "Gestão de campanhas, transparência e auditoria" },
      { "name": "Doador", "description": "Contribuição e acompanhamento de doações" }
    ]
  },
  "clients": [
    {
      "clientId": "conexao-web",
      "name": "Conexão Solidária Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/signin-oidc",
        "http://127.0.0.1:5000/signin-oidc",
        "http://localhost:31080/signin-oidc",
        "https://conexao-solidaria.example.com/signin-oidc"
      ],
      "webOrigins": [
        "http://localhost:5000",
        "http://127.0.0.1:5000",
        "http://localhost:31080",
        "https://conexao-solidaria.example.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5000/*##http://127.0.0.1:5000/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "conexao-solidaria",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "conexao-cli",
      "name": "Conexao Solidaria Local Automation",
      "description": "Cliente exclusivo para verificacoes automatizadas do ambiente local",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "conexao-solidaria",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "conexao-solidaria",
      "name": "Conexao Solidaria APIs",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ]
}
