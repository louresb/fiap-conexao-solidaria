{
  "Auth": {
    "Authority": "http://keycloak:8080/realms/conexao-solidaria",
    "Issuer": "http://localhost:8080/realms/conexao-solidaria",
    "Audience": "conexao-solidaria",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/donors/{**catch-all}" }
      },
      "campaign-management": {
        "ClusterId": "campaigns",
        "Match": { "Path": "/api/management/campaigns/{**catch-all}" }
      },
      "public-campaigns": {
        "ClusterId": "campaigns",
        "Match": { "Path": "/api/public/{**catch-all}" }
      },
      "donations": {
        "ClusterId": "campaigns",
        "Match": { "Path": "/api/donations/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },
      "payment-webhooks": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/payment-webhooks/{**catch-all}" }
      },
      "audit": {
        "ClusterId": "audit",
        "Match": { "Path": "/api/audit/{**catch-all}" }
      },
      "knowledge": {
        "ClusterId": "knowledge",
        "Match": { "Path": "/api/knowledge/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-api:8080/" } }
      },
      "campaigns": {
        "Destinations": { "primary": { "Address": "http://campaigns-api:8080/" } }
      },
      "payments": {
        "Destinations": { "primary": { "Address": "http://payments-api:8080/" } }
      },
      "audit": {
        "Destinations": { "primary": { "Address": "http://audit-api:8080/" } }
      },
      "knowledge": {
        "Destinations": { "primary": { "Address": "http://knowledge-api:8080/" } }
      }
    }
  },
  "Readiness": {
    "Dependencies": {
      "identity": "http://identity-api:8080/health/ready",
      "campaigns": "http://campaigns-api:8080/health/ready",
      "payments": "http://payments-api:8080/health/ready",
      "audit": "http://audit-api:8080/health/ready",
      "knowledge": "http://knowledge-api:8080/health/ready"
    }
  },
  "Observability": {
    "LokiUrl": ""
  },
  "AllowedHosts": "*"
}
