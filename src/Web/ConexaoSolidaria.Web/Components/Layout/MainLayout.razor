@inherits LayoutComponentBase
@inject IStringLocalizer<WebResources> Localizer

<div class="site-shell" data-interactive="@(_interactiveReady ? "ready" : null)">
    <NavMenu />
    <main class="page-content">
        @Body
    </main>
    <footer class="site-footer">
        <div class="footer-inner">
            <div>
                <a class="brand brand-footer" href="/" aria-label="@Localizer["BrandHomeAria"]">
                    <span class="brand-mark" aria-hidden="true">CS</span>
                    <span><strong>Conexão Solidária</strong><small>@Localizer["FooterTagline"]</small></span>
                </a>
            </div>
            <p>@Localizer["FooterDescription"]</p>
            <nav aria-label="@Localizer["FooterNavigation"]">
                <a href="/transparencia">@Localizer["Transparency"]</a>
                <a href="/assistente">@Localizer["AskQuestions"]</a>
                <a href="/acesso">@Localizer["AccessPlatform"]</a>
            </nav>
        </div>
    </footer>
</div>

@code {
    private bool _interactiveReady;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _interactiveReady = true;
        StateHasChanged();
    }
}

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["ConnectionInterrupted"]
    <a href="." class="reload">@Localizer["Reload"]</a>
    <button type="button" class="dismiss" aria-label="@Localizer["Close"]">×</button>
</div>
