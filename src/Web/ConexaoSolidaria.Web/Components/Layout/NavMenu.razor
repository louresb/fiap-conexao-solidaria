<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/" aria-label="Página inicial da Conexão Solidária">
            <span class="brand-mark" aria-hidden="true">CS</span>
            <span><strong>Conexão Solidária</strong><small>Rede de impacto social</small></span>
        </a>

        <nav class="primary-nav" aria-label="Navegação principal">
            <NavLink href="/" Match="NavLinkMatch.All">Campanhas</NavLink>
            <NavLink href="/transparencia">Transparência</NavLink>
            <NavLink href="/assistente">Assistente</NavLink>
            <AuthorizeView Roles="GestorONG">
                <Authorized>
                    <NavLink href="/gestao">Gestão</NavLink>
                    <NavLink href="/gestao/auditoria">Auditoria</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="header-actions">
            <details class="tenant-menu">
                <summary aria-label="Selecionar organização">Organizações</summary>
                <div class="tenant-popover">
                    @foreach (var tenant in TenantCatalog.All)
                    {
                        <a href="/?tenant=@tenant.Id">
                            <strong>@tenant.Name</strong>
                            <span>@tenant.Location</span>
                        </a>
                    }
                </div>
            </details>
            <AuthorizeView>
                <Authorized Context="auth">
                    <span class="user-name">@DisplayName(auth.User)</span>
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button class="button button-quiet" type="submit">Sair</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a class="button button-outline" href="/acesso">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</header>

@code {
    private static string DisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("given_name")?.Value
        ?? user.Identity?.Name
        ?? "Minha conta";
}
