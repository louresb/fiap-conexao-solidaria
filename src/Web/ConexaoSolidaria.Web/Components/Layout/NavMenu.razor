@inject IStringLocalizer<WebResources> Localizer

<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/" aria-label="@Localizer["BrandHomeAria"]">
            <span class="brand-mark" aria-hidden="true">CS</span>
            <span><strong>Conexão Solidária</strong><small>@Localizer["BrandTagline"]</small></span>
        </a>

        <nav class="primary-nav" aria-label="@Localizer["PrimaryNavigation"]">
            <NavLink href="/" Match="NavLinkMatch.All">@Localizer["Campaigns"]</NavLink>
            <NavLink href="/transparencia">@Localizer["Transparency"]</NavLink>
            <NavLink href="/assistente">@Localizer["Assistant"]</NavLink>
            <AuthorizeView Roles="Doador">
                <Authorized>
                    <NavLink href="/minhas-doacoes">@Localizer["MyDonations"]</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="GestorONG">
                <Authorized>
                    <NavLink href="/gestao">@Localizer["Management"]</NavLink>
                    <NavLink href="/gestao/auditoria">@Localizer["Audit"]</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="AdminSaaS">
                <Authorized>
                    <NavLink href="/administracao">@Localizer["Platform"]</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="header-actions">
            <details class="tenant-menu">
                <summary aria-label="@Localizer["SelectOrganization"]">@Localizer["Organizations"]</summary>
                <div class="tenant-popover">
                    @foreach (var tenant in TenantCatalog.All)
                    {
                        <a href="/?tenant=@tenant.Id">
                            <strong>@tenant.Name</strong>
                        </a>
                    }
                </div>
            </details>
            <CultureSelector />
            <div class="desktop-auth">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <span class="user-name">@DisplayName(auth.User)</span>
                        <form method="post" action="/account/logout">
                            <AntiforgeryToken />
                            <button class="button button-quiet" type="submit">@Localizer["SignOut"]</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a class="button button-outline" href="/acesso">@Localizer["SignIn"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div class="mobile-menu">
                <button type="button" aria-label="@Localizer["OpenNavigation"]" aria-expanded="@(MobileMenuOpen ? "true" : "false")" @onclick="ToggleMobileMenu">
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                    <span aria-hidden="true"></span>
                </button>
                @if (MobileMenuOpen)
                {
                    <div class="mobile-menu-popover">
                        <nav aria-label="@Localizer["MobileNavigation"]">
                            <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">@Localizer["Campaigns"]</NavLink>
                            <NavLink href="/transparencia" @onclick="CloseMobileMenu">@Localizer["Transparency"]</NavLink>
                            <NavLink href="/assistente" @onclick="CloseMobileMenu">@Localizer["Assistant"]</NavLink>
                            <AuthorizeView Roles="Doador">
                                <Authorized>
                                    <NavLink href="/minhas-doacoes" @onclick="CloseMobileMenu">@Localizer["MyDonations"]</NavLink>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Roles="GestorONG">
                                <Authorized>
                                    <NavLink href="/gestao" @onclick="CloseMobileMenu">@Localizer["Management"]</NavLink>
                                    <NavLink href="/gestao/auditoria" @onclick="CloseMobileMenu">@Localizer["Audit"]</NavLink>
                                </Authorized>
                            </AuthorizeView>
                            <AuthorizeView Roles="AdminSaaS">
                                <Authorized>
                                    <NavLink href="/administracao" @onclick="CloseMobileMenu">@Localizer["Platform"]</NavLink>
                                </Authorized>
                            </AuthorizeView>
                        </nav>
                        <div class="mobile-tenant-list">
                            <strong>@Localizer["Organizations"]</strong>
                            @foreach (var tenant in TenantCatalog.All)
                            {
                                <a href="/?tenant=@tenant.Id" @onclick="CloseMobileMenu">
                                    <span>@tenant.Name</span>
                                </a>
                            }
                        </div>
                        <div class="mobile-auth">
                            <AuthorizeView>
                                <Authorized Context="mobileAuth">
                                    <span>@DisplayName(mobileAuth.User)</span>
                                    <form method="post" action="/account/logout">
                                        <AntiforgeryToken />
                                        <button class="button button-outline button-full" type="submit">@Localizer["SignOut"]</button>
                                    </form>
                                </Authorized>
                                <NotAuthorized>
                                    <a class="button button-outline button-full" href="/acesso">@Localizer["SignIn"]</a>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</header>

@code {
    private bool MobileMenuOpen { get; set; }

    private void ToggleMobileMenu() => MobileMenuOpen = !MobileMenuOpen;
    private void CloseMobileMenu() => MobileMenuOpen = false;

    private string DisplayName(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("given_name")?.Value
        ?? user.Identity?.Name
        ?? Localizer["MyAccount"];
}
