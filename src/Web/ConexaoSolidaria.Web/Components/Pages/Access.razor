@page "/acesso"
@inject IConfiguration Configuration
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["AccessPageTitle"]</PageTitle>

<section class="access-page">
    <div class="access-visual">
        <img src="/images/campaign-biblioteca-de-bairro.jpg" alt="@Localizer["AccessImageAlt"]" />
        <div>
            <p class="eyebrow">@Localizer["AccessEyebrow"]</p>
            <h1>Conexão Solidária</h1>
            <p>@Localizer["AccessIntroduction"]</p>
        </div>
    </div>
    <div class="access-options">
        <p class="eyebrow">@Localizer["SecureAccess"]</p>
        <h2>@Localizer["ChooseYourSpace"]</h2>
        <a class="access-role" href="/account/login?returnUrl=/">
            <span class="role-initial">D</span>
            <span><strong>@Localizer["DonorArea"]</strong><small>@Localizer["DonorAreaDescription"]</small></span>
            <i aria-hidden="true">→</i>
        </a>
        <a class="text-link access-register" href="/cadastro">@Localizer["CreateDonorAccount"]</a>
        <a class="access-role" href="/account/login?returnUrl=/gestao">
            <span class="role-initial manager">G</span>
            <span><strong>@Localizer["OrganizationManagement"]</strong><small>@Localizer["OrganizationManagementDescription"]</small></span>
            <i aria-hidden="true">→</i>
        </a>
        <a class="access-role" href="/account/login?returnUrl=/administracao">
            <span class="role-initial admin">A</span>
            <span><strong>@Localizer["PlatformAdministration"]</strong><small>@Localizer["PlatformAdministrationDescription"]</small></span>
            <i aria-hidden="true">→</i>
        </a>
        <p class="access-security">@Localizer["AuthenticationProtection"]</p>
        @if (ShowLocalAccess)
        {
            <details class="access-help local-access">
                <summary>@Localizer["EvaluationAccounts"]</summary>
                <div>
                    <strong>@Localizer["EsperancaManager"]</strong>
                    <code>gestor.esperanca@conexaosolidaria.local</code>
                    <code>@Configuration["DemoAccess:ManagerPassword"]</code>
                </div>
                <div>
                    <strong>@Localizer["EsperancaDonor"]</strong>
                    <code>doador.esperanca@conexaosolidaria.local</code>
                    <code>@Configuration["DemoAccess:DonorPassword"]</code>
                </div>
                <div>
                    <strong>@Localizer["PlatformAdmin"]</strong>
                    <code>admin.plataforma@conexaosolidaria.local</code>
                    <code>@Configuration["DemoAccess:AdminPassword"]</code>
                </div>
            </details>
        }
        <details class="access-help">
            <summary>@Localizer["NeedAccessHelp"]</summary>
            <p>@Localizer["AccessHelpDescription"]</p>
        </details>
    </div>
</section>

@code {
    private bool ShowLocalAccess =>
        Configuration.GetValue("DemoAccess:Enabled", false)
        && !string.IsNullOrWhiteSpace(Configuration["DemoAccess:ManagerPassword"])
        && !string.IsNullOrWhiteSpace(Configuration["DemoAccess:DonorPassword"])
        && !string.IsNullOrWhiteSpace(Configuration["DemoAccess:AdminPassword"]);
}
