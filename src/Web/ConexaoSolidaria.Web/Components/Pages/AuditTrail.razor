@page "/gestao/auditoria"
@attribute [Authorize(Roles = "GestorONG")]
@using System.Text.Json
@using ConexaoSolidaria.Contracts.Audit
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["AuditPageTitle"]</PageTitle>

<section class="management-heading">
    <div class="section-inner split-heading">
        <div><p class="eyebrow">@Localizer["Governance"]</p><h1>@Localizer["AuditTrail"]</h1><p>@Localizer["AuditTrailDescription"]</p></div>
        <button class="button button-outline" type="button" @onclick="LoadAsync" disabled="@Loading">@Localizer["Refresh"]</button>
    </div>
</section>

<section class="section-inner audit-page">
    <div class="audit-toolbar">
        <div class="search-control compact-search">
            <label for="event-filter">@Localizer["FilterEvents"]</label>
            <input id="event-filter" @bind="Filter" @bind:event="oninput" placeholder="@Localizer["EventFilterPlaceholder"]" />
        </div>
        <span>@Localizer["VisibleRecords", FilteredEvents.Count()]</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error">@Error</div>
    }
    else
    {
        <div class="audit-timeline">
            @foreach (var item in FilteredEvents)
            {
                <article>
                    <span class="event-dot"></span>
                    <div class="audit-event-heading">
                        <div><strong>@EventLabel(item.EventType)</strong><span>@item.EventType</span></div>
                        <time datetime="@item.Timestamp.ToString("O")">@item.Timestamp.LocalDateTime.ToString("G", Culture)</time>
                    </div>
                    <dl>
                        <div><dt>@Localizer["Source"]</dt><dd>@item.Source</dd></div>
                        <div><dt>Tenant</dt><dd>@item.TenantId</dd></div>
                        <div><dt>@Localizer["Correlation"]</dt><dd><code>@item.CorrelationId</code></dd></div>
                    </dl>
                    <details>
                        <summary>@Localizer["InspectProtectedPayload"]</summary>
                        <pre>@PrettyJson(item.PayloadJson)</pre>
                    </details>
                </article>
            }
        </div>
    }
</section>

@code {
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private IReadOnlyList<AuditEventDto> Events { get; set; } = [];
    private string Filter { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;
    private bool Loading { get; set; }
    private IEnumerable<AuditEventDto> FilteredEvents => string.IsNullOrWhiteSpace(Filter)
        ? Events
        : Events.Where(item => $"{item.EventType} {item.Source} {item.CorrelationId}".Contains(Filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = string.Empty;
        try
        {
            Events = await Api.GetAuditAsync(100, CancellationToken.None);
        }
        catch
        {
            Error = Localizer["AuditQueryError"];
        }
        finally
        {
            Loading = false;
        }
    }

    private static string PrettyJson(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch (JsonException)
        {
            return json;
        }
    }

    private string EventLabel(string eventType) => eventType switch
    {
        "DonorRegistered" => Localizer["Event.DonorRegistered"],
        "CampaignCreated" => Localizer["Event.CampaignCreated"],
        "CampaignUpdated" => Localizer["Event.CampaignUpdated"],
        "CampaignCancelled" => Localizer["Event.CampaignCancelled"],
        "DonationIntentCreated" => Localizer["Event.DonationIntentCreated"],
        "PaymentAwaitingConfirmation" => Localizer["Event.PaymentAwaitingConfirmation"],
        "PaymentConfirmed" => Localizer["Event.PaymentConfirmed"],
        "DonationProcessed" => Localizer["Event.DonationProcessed"],
        "CampaignGoalReached" => Localizer["Event.CampaignGoalReached"],
        "KnowledgeQuestionAnswered" => Localizer["Event.KnowledgeQuestionAnswered"],
        _ => eventType
    };
}
