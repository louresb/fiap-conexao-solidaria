@page "/campanhas/{Id:guid}"
@using ConexaoSolidaria.Contracts.Campaigns
@using ConexaoSolidaria.Contracts.Donations
@using ConexaoSolidaria.Contracts.Payments
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["CampaignPageTitle", Campaign?.Title ?? Localizer["Campaign"].Value]</PageTitle>

@if (Loading)
{
    <div class="page-loading">@Localizer["LoadingCampaign"]</div>
}
else if (Campaign is null)
{
    <section class="narrow-page empty-state">
        <h1>@Localizer["CampaignNotFound"]</h1>
        <p>@Localizer["CampaignNotFoundDescription"]</p>
        <a class="button button-dark" href="/?tenant=@Tenant.Id">@Localizer["BackToCampaigns"]</a>
    </section>
}
else
{
    var visual = CampaignPresentations.For(Campaign);
    <section class="campaign-detail-hero @Tenant.AccentClass">
        <div class="detail-image"><img src="@visual.Image" alt="" /></div>
        <div class="detail-summary">
            <a class="back-link" href="/?tenant=@Tenant.Id">← @Localizer["AllCampaigns"]</a>
            <p class="eyebrow">@Localizer[$"Category.{visual.Category}"] · @Tenant.Name</p>
            <h1>@Campaign.Title</h1>
            <p class="detail-description">@CampaignDescription</p>
            <div class="detail-progress">
                <div class="progress-track"><span style="width:@Math.Min(Campaign.ProgressPercent, 100).ToString("0.##", Invariant)%"></span></div>
                <div><strong>@Campaign.TotalRaised.ToString("C0", Culture)</strong><span> @Localizer["RaisedOf", Campaign.GoalAmount.ToString("C0", Culture)]</span></div>
            </div>
            <dl class="detail-facts">
                <div><dt>@Localizer["Deadline"]</dt><dd>@Campaign.EndDate.ToString("d", Culture)</dd></div>
                <div><dt>@Localizer["Progress"]</dt><dd>@Campaign.ProgressPercent.ToString("0", Culture)%</dd></div>
                <div><dt>@Localizer["AccountabilityShort"]</dt><dd>@Localizer["ContinuousUpdates"]</dd></div>
            </dl>
        </div>
    </section>

    <section class="detail-content section-inner">
        <article class="campaign-story">
            <p class="eyebrow">@Localizer["ExpectedImpact"]</p>
            <h2>@Localizer["VisibleDestinationTitle"]</h2>
            <p>@CampaignDescription @Localizer["VisibleDestinationDescription"]</p>
            <div class="process-steps">
                <div><span>1</span><strong>@Localizer["YouChoose"]</strong><p>@Localizer["YouChooseDescription"]</p></div>
                <div><span>2</span><strong>@Localizer["WeConfirm"]</strong><p>@Localizer["WeConfirmDescription"]</p></div>
                <div><span>3</span><strong>@Localizer["EveryoneTracks"]</strong><p>@Localizer["EveryoneTracksDescription"]</p></div>
            </div>
        </article>

        <aside class="donation-panel" aria-labelledby="donation-title">
            <p class="eyebrow">@Localizer["Contribute"]</p>
            <h2 id="donation-title">@Localizer["JoinCampaign"]</h2>

            @if (!User.IsAuthenticated)
            {
                <p>@Localizer["SignInToDonateDescription"]</p>
                <a class="button button-primary button-full" href="/account/login?returnUrl=@Uri.EscapeDataString($"/campanhas/{Id}?tenant={Tenant.Id}")">@Localizer["SignInToDonate"]</a>
                <a class="text-link" href="/acesso">@Localizer["NoAccountYet"]</a>
            }
            else if (!User.IsDonor)
            {
                <div class="notice">@Localizer["ManagerCannotDonate"]</div>
            }
            else if (!string.Equals(User.TenantId, Tenant.Id, StringComparison.OrdinalIgnoreCase))
            {
                <div class="notice">@Localizer["DifferentOrganization", TenantCatalog.Resolve(User.TenantId).Name]</div>
            }
            else if (Payment is null)
            {
                <label>@Localizer["ContributionAmount"]</label>
                <div class="amount-options">
                    @foreach (var value in SuggestedAmounts)
                    {
                        <button type="button" class="@(Amount == value ? "selected" : null)" @onclick="() => Amount = value">@value.ToString("C0", Culture)</button>
                    }
                </div>
                <input class="amount-input" type="number" min="5" step="5" @bind="Amount" aria-label="@Localizer["OtherAmount"]" />

                <fieldset class="payment-methods">
                    <legend>@Localizer["PaymentMethod"]</legend>
                    <label><input type="radio" name="payment" value="pix" @onchange="SelectPix" checked="@(PaymentMethod == "pix")" /> Pix</label>
                    <label><input type="radio" name="payment" value="credit_card" @onchange="SelectCreditCard" checked="@(PaymentMethod == "credit_card")" /> @Localizer["CreditCard"]</label>
                    <label><input type="radio" name="payment" value="bank_slip" @onchange="SelectBankSlip" checked="@(PaymentMethod == "bank_slip")" /> @Localizer["BankSlip"]</label>
                </fieldset>

                <button class="button button-primary button-full" type="button" @onclick="DonateAsync" disabled="@Submitting">
                    @(Submitting ? Localizer["PreparingPayment"] : Localizer["ContinueContribution"])
                </button>
            }
            else
            {
                <div class="payment-status">
                    <span class="status-pill">@PaymentStatusLabel</span>
                    <strong>@Payment.Amount.ToString("C2", Culture)</strong>
                    <p>@Localizer["Reference"] <code>@Payment.ProviderPaymentId</code></p>
                    @if (!string.IsNullOrWhiteSpace(Payment.QrCodePayload) && Payment.Status != "Confirmed")
                    {
                        <label>@Localizer["PixCopyPasteCode"]</label>
                        <code class="pix-code">@Payment.QrCodePayload</code>
                    }
                    @if (Payment.Status != "Confirmed")
                    {
                        <details class="sandbox-helper">
                            <summary>@Localizer["PaymentEnvironment"]</summary>
                            <p>@Localizer["PaymentSandboxDescription"]</p>
                            <button class="button button-dark button-full" type="button" @onclick="ConfirmAsync" disabled="@Submitting">@Localizer["ConfirmInSandbox"]</button>
                        </details>
                    }
                    else
                    {
                        <div class="success-message"><strong>@Localizer["ContributionConfirmed"]</strong><span>@Localizer["ImpactProcessing"]</span></div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="notice notice-error" role="alert">@Error</div>
            }
            <p class="privacy-note">@Localizer["ContributionPrivacy"]</p>
        </aside>
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "tenant")] public string? TenantId { get; set; }

    private static readonly decimal[] SuggestedAmounts = [25, 50, 100, 200];
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private static readonly System.Globalization.CultureInfo Invariant = System.Globalization.CultureInfo.InvariantCulture;
    private TenantBrand Tenant => TenantCatalog.Resolve(TenantId);
    private ActiveCampaignDto? Campaign { get; set; }
    private UserApiContext User { get; set; } = new(false, "", "", "", "", false, false);
    private PaymentIntentDto? Payment { get; set; }
    private decimal Amount { get; set; } = 50;
    private string PaymentMethod { get; set; } = "pix";
    private string Error { get; set; } = string.Empty;
    private bool Loading { get; set; } = true;
    private bool Submitting { get; set; }
    private string PaymentStatusLabel => Payment?.Status == "Confirmed" ? Localizer["PaymentConfirmedStatus"] : Localizer["AwaitingConfirmation"];
    private string CampaignDescription
    {
        get
        {
            if (Campaign is null)
            {
                return string.Empty;
            }

            var resourceKey = CampaignPresentations.For(Campaign).DescriptionResourceKey;
            return resourceKey is null ? Campaign.Description : Localizer[resourceKey];
        }
    }

    private void SelectPix() => PaymentMethod = "pix";
    private void SelectCreditCard() => PaymentMethod = "credit_card";
    private void SelectBankSlip() => PaymentMethod = "bank_slip";

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        User = await Api.GetUserContextAsync();
        try
        {
            var campaigns = await Api.GetActiveCampaignsAsync(Tenant.Id, CancellationToken.None);
            Campaign = campaigns.Items.FirstOrDefault(item => item.Id == Id);
        }
        catch
        {
            Error = Localizer["CampaignQueryError"];
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task DonateAsync()
    {
        if (Campaign is null || Amount <= 0)
        {
            return;
        }

        Submitting = true;
        Error = string.Empty;
        try
        {
            var accepted = await Api.CreateDonationAsync(
                new CreateDonationRequest(
                    Campaign.Id,
                    Amount,
                    PaymentMethod,
                    User.Subject,
                    User.Email),
                CancellationToken.None);
            for (var attempt = 0; attempt < 12 && Payment is null; attempt++)
            {
                await Task.Delay(500);
                Payment = await Api.GetPaymentByDonationAsync(accepted.Id, CancellationToken.None);
            }

            if (Payment is null)
            {
                Error = Localizer["DonationAcceptedPaymentPending"];
            }
        }
        catch
        {
            Error = Localizer["ContributionStartError"];
        }
        finally
        {
            Submitting = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (Payment is null)
        {
            return;
        }

        var paymentId = Payment.Id;
        var donationId = Payment.DonationId;
        var totalBeforeConfirmation = Campaign?.TotalRaised;
        Submitting = true;
        Error = string.Empty;
        try
        {
            await Api.ConfirmSandboxPaymentAsync(paymentId, CancellationToken.None);

            for (var attempt = 0; attempt < 24; attempt++)
            {
                await Task.Delay(500);
                Payment = await Api.GetPaymentByDonationAsync(donationId, CancellationToken.None);
                var campaigns = await Api.GetActiveCampaignsAsync(Tenant.Id, CancellationToken.None);
                Campaign = campaigns.Items.FirstOrDefault(item => item.Id == Id);

                var paymentConfirmed = Payment?.Status == "Confirmed";
                var projectionUpdated = totalBeforeConfirmation is null ||
                    Campaign?.TotalRaised > totalBeforeConfirmation;
                if (paymentConfirmed && projectionUpdated)
                {
                    break;
                }
            }
        }
        catch
        {
            Error = Localizer["ConfirmationError"];
        }
        finally
        {
            Submitting = false;
        }
    }
}
