@page "/gestao/campanhas/nova"
@page "/gestao/campanhas/{Id:guid}/editar"
@attribute [Authorize(Roles = "GestorONG")]
@using System.ComponentModel.DataAnnotations
@using ConexaoSolidaria.Contracts.Campaigns
@using ConexaoSolidaria.Contracts.Validation
@inject SolidariaApiClient Api
@inject NavigationManager Navigation
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@(Id.HasValue ? Localizer["EditCampaignPageTitle"] : Localizer["NewCampaignPageTitle"])</PageTitle>

<section class="management-heading">
    <div class="section-inner">
        <a class="back-link" href="/gestao/campanhas">← @Localizer["BackToCampaigns"]</a>
        <p class="eyebrow">@(Id.HasValue ? Localizer["UpdateInitiative"] : Localizer["NewInitiative"])</p>
        <h1>@(Id.HasValue ? Localizer["EditCampaign"] : Localizer["CreateCampaign"])</h1>
        <p>@Localizer["CampaignEditorDescription"]</p>
    </div>
</section>

<section class="section-inner editor-page">
    <EditForm Model="Model" OnValidSubmit="SaveAsync" FormName="campaign-editor">
        <DataAnnotationsValidator />
        <div class="editor-layout">
            <div class="form-section">
                <div class="section-heading"><p class="eyebrow">@Localizer["PublicContent"]</p><h2>@Localizer["CampaignInformation"]</h2></div>
                <div class="form-field">
                    <label for="title">@Localizer["Title"]</label>
                    <InputText id="title" @bind-Value="Model.Title" />
                    <ValidationMessage For="() => Model.Title" />
                </div>
                <div class="form-field">
                    <label for="description">@Localizer["Description"]</label>
                    <InputTextArea id="description" @bind-Value="Model.Description" />
                    <ValidationMessage For="() => Model.Description" />
                    <small>@Localizer["CampaignDescriptionHelp"]</small>
                </div>
            </div>

            <div class="form-section">
                <div class="section-heading"><p class="eyebrow">@Localizer["Planning"]</p><h2>@Localizer["GoalAndPeriod"]</h2></div>
                <div class="form-grid">
                    <div class="form-field">
                        <label for="goal">@Localizer["FinancialGoal"]</label>
                        <InputNumber id="goal" @bind-Value="Model.GoalAmount" />
                        <ValidationMessage For="() => Model.GoalAmount" />
                    </div>
                    <div class="form-field">
                        <label for="status">@Localizer["Status"]</label>
                        <InputSelect id="status" @bind-Value="Model.Status">
                            @foreach (var status in AvailableStatuses)
                            {
                                <option value="@status">@StatusLabel(status)</option>
                            }
                        </InputSelect>
                        <small>@Localizer["StatusWorkflowHelp"]</small>
                    </div>
                    <div class="form-field">
                        <label for="start">@Localizer["StartDate"]</label>
                        <InputDate id="start" @bind-Value="Model.StartDate" />
                        <ValidationMessage For="() => Model.StartDate" />
                    </div>
                    <div class="form-field">
                        <label for="end">@Localizer["EndDate"]</label>
                        <InputDate id="end" @bind-Value="Model.EndDate" />
                        <ValidationMessage For="() => Model.EndDate" />
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="notice notice-error">@Error</div>
        }
        <div class="editor-actions">
            <a class="button button-outline" href="/gestao/campanhas">@Localizer["Cancel"]</a>
            <button class="button button-primary" type="submit" disabled="@Saving">@(Saving ? Localizer["Saving"] : Localizer["SaveCampaign"])</button>
        </div>
    </EditForm>
</section>

@code {
    [Parameter] public Guid? Id { get; set; }

    private CampaignFormModel Model { get; set; } = new();
    private bool Saving { get; set; }
    private string Error { get; set; } = string.Empty;
    private CampaignStatus PersistedStatus { get; set; } = CampaignStatus.Rascunho;
    private IReadOnlyList<CampaignStatus> AvailableStatuses => Id.HasValue
        ? CampaignRules.NextStatuses(PersistedStatus)
        : [CampaignStatus.Rascunho];

    protected override async Task OnParametersSetAsync()
    {
        if (!Id.HasValue)
        {
            Model = new CampaignFormModel();
            return;
        }

        try
        {
            var campaign = (await Api.GetManagedCampaignsAsync(CancellationToken.None)).FirstOrDefault(item => item.Id == Id);
            if (campaign is null)
            {
                Error = Localizer["CampaignNotFound"];
                return;
            }

            Model = new CampaignFormModel
            {
                Title = campaign.Title,
                Description = campaign.Description,
                StartDate = campaign.StartDate,
                EndDate = campaign.EndDate,
                GoalAmount = campaign.GoalAmount,
                Status = campaign.Status
            };
            PersistedStatus = campaign.Status;
        }
        catch
        {
            Error = Localizer["CampaignQueryError"];
        }
    }

    private async Task SaveAsync()
    {
        Saving = true;
        Error = string.Empty;
        try
        {
            if (Id.HasValue)
            {
                await Api.UpdateCampaignAsync(
                    Id.Value,
                    new UpdateCampaignRequest(Model.Title, Model.Description, Model.StartDate, Model.EndDate, Model.GoalAmount, Model.Status),
                    CancellationToken.None);
            }
            else
            {
                await Api.CreateCampaignAsync(
                    new CreateCampaignRequest(Model.Title, Model.Description, Model.StartDate, Model.EndDate, Model.GoalAmount, Model.Status),
                    CancellationToken.None);
            }

            Navigation.NavigateTo("/gestao/campanhas");
        }
        catch (SolidariaApiException exception)
        {
            Error = exception.Detail.Contains("data", StringComparison.OrdinalIgnoreCase)
                ? Localizer["CampaignPeriodGoalError"]
                : Localizer["CampaignSaveError"];
        }
        finally
        {
            Saving = false;
        }
    }

    private sealed class CampaignFormModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CampaignTitleRequired))]
        [StringLength(160, MinimumLength = 5, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CampaignTitleLength))]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CampaignDescriptionRequired))]
        [StringLength(2000, MinimumLength = 20, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CampaignDescriptionLength))]
        public string Description { get; set; } = string.Empty;

        [Range(1, 100000000, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CampaignGoalPositive))]
        public decimal GoalAmount { get; set; } = 25000;

        public DateOnly StartDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly EndDate { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddMonths(3));
        public CampaignStatus Status { get; set; } = CampaignStatus.Rascunho;
    }

    private string StatusLabel(CampaignStatus status) => status switch
    {
        CampaignStatus.Rascunho => Localizer["StatusDraft"],
        CampaignStatus.EmRevisao => Localizer["StatusInReview"],
        CampaignStatus.Aprovada => Localizer["StatusApproved"],
        CampaignStatus.Ativa => Localizer["StatusPublished"],
        CampaignStatus.Concluida => Localizer["StatusCompleted"],
        CampaignStatus.Cancelada => Localizer["StatusCancelled"],
        _ => status.ToString()
    };
}
