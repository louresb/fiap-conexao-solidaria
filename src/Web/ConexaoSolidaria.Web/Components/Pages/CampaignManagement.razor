@page "/gestao/campanhas"
@attribute [Authorize(Roles = "GestorONG")]
@using ConexaoSolidaria.Contracts.Campaigns
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["CampaignManagementPageTitle"]</PageTitle>

<section class="management-heading">
    <div class="section-inner split-heading">
        <div><p class="eyebrow">@Localizer["CampaignManagement"]</p><h1>@Localizer["Campaigns"]</h1><p>@Localizer["CampaignManagementDescription"]</p></div>
        <a class="button button-primary" href="/gestao/campanhas/nova">@Localizer["NewCampaign"]</a>
    </div>
</section>

<section class="section-inner management-page">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error">@Error</div>
    }
    <div class="filter-tabs" role="tablist" aria-label="@Localizer["FilterCampaigns"]">
        @foreach (var filter in Filters)
        {
            <button type="button" class="@(CurrentFilter == filter.Key ? "active" : null)" @onclick="() => CurrentFilter = filter.Key">@filter.Value</button>
        }
    </div>

    <div class="campaign-admin-table">
        <table class="data-table">
            <thead><tr><th>@Localizer["Campaign"]</th><th>@Localizer["Period"]</th><th>@Localizer["Fundraising"]</th><th>@Localizer["Status"]</th><th><span class="sr-only">@Localizer["Actions"]</span></th></tr></thead>
            <tbody>
                @foreach (var campaign in FilteredCampaigns)
                {
                    <tr>
                        <td><strong>@campaign.Title</strong><small>@campaign.Description</small></td>
                        <td>@campaign.StartDate.ToString("d", Culture) – @campaign.EndDate.ToString("d", Culture)</td>
                        <td>@campaign.TotalRaised.ToString("C0", Culture)<small>@Localizer["Goal"] @campaign.GoalAmount.ToString("C0", Culture)</small></td>
                        <td><span class="status-badge status-@campaign.Status.ToString().ToLowerInvariant()">@StatusLabel(campaign.Status)</span></td>
                        <td class="table-actions">
                            <a class="button button-quiet" href="/gestao/campanhas/@campaign.Id/editar">@Localizer["Edit"]</a>
                            @if (campaign.Status == CampaignStatus.Ativa)
                            {
                                @if (PendingCancellation == campaign.Id)
                                {
                                    <button class="button button-danger" type="button" @onclick="() => CancelAsync(campaign.Id)">@Localizer["Confirm"]</button>
                                    <button class="button button-quiet" type="button" @onclick="() => PendingCancellation = null">@Localizer["Back"]</button>
                                }
                                else
                                {
                                    <button class="button button-quiet" type="button" @onclick="() => PendingCancellation = campaign.Id">@Localizer["CloseCampaign"]</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private IReadOnlyDictionary<string, string> Filters => new Dictionary<string, string>
    {
        ["all"] = Localizer["FilterAll"],
        ["active"] = Localizer["FilterPublished"],
        ["workflow"] = Localizer["FilterInPreparation"],
        ["closed"] = Localizer["FilterClosed"]
    };
    private IReadOnlyList<CampaignDto> Campaigns { get; set; } = [];
    private string CurrentFilter { get; set; } = "all";
    private Guid? PendingCancellation { get; set; }
    private string Error { get; set; } = string.Empty;
    private IEnumerable<CampaignDto> FilteredCampaigns => CurrentFilter switch
    {
        "active" => Campaigns.Where(c => c.Status == CampaignStatus.Ativa),
        "workflow" => Campaigns.Where(c => c.Status is CampaignStatus.Rascunho or CampaignStatus.EmRevisao or CampaignStatus.Aprovada),
        "closed" => Campaigns.Where(c => c.Status is CampaignStatus.Concluida or CampaignStatus.Cancelada),
        _ => Campaigns
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            Campaigns = await Api.GetManagedCampaignsAsync(CancellationToken.None);
        }
        catch
        {
            Error = Localizer["ManagedCampaignsLoadError"];
        }
    }

    private async Task CancelAsync(Guid id)
    {
        try
        {
            await Api.CancelCampaignAsync(id, CancellationToken.None);
            PendingCancellation = null;
            await LoadAsync();
        }
        catch
        {
            Error = Localizer["CampaignCloseError"];
        }
    }

    private string StatusLabel(CampaignStatus status) => status switch
    {
        CampaignStatus.Rascunho => Localizer["StatusDraft"],
        CampaignStatus.EmRevisao => Localizer["StatusInReview"],
        CampaignStatus.Aprovada => Localizer["StatusApproved"],
        CampaignStatus.Ativa => Localizer["StatusPublished"],
        CampaignStatus.Concluida => Localizer["StatusCompleted"],
        CampaignStatus.Cancelada => Localizer["StatusCancelled"],
        _ => status.ToString()
    };
}
