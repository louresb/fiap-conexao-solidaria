@page "/cadastro"
@using System.ComponentModel.DataAnnotations
@using ConexaoSolidaria.Contracts.Identity
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["DonorRegistrationPageTitle"]</PageTitle>

<section class="registration-page">
    <div class="registration-intro @Tenant.AccentClass">
        <p class="eyebrow">@Tenant.Name</p>
        <h1>@Localizer["CreateDonorAccountTitle"]</h1>
        <p>@Localizer["CreateDonorAccountDescription"]</p>
        <div class="registration-benefits">
            <span>@Localizer["ProtectedIdentity"]</span>
            <span>@Localizer["OrganizationHistory"]</span>
            <span>@Localizer["TransparentConsent"]</span>
        </div>
    </div>
    <div class="registration-form">
        @if (Completed)
        {
            <div class="registration-success">
                <span aria-hidden="true">✓</span>
                <h2>@Localizer["RegistrationCompleted"]</h2>
                <p>@Localizer["AccountLinked", Tenant.Name]</p>
                <a class="button button-primary button-full" href="/account/login?returnUrl=@Uri.EscapeDataString($"/?tenant={Tenant.Id}")">@Localizer["SignInNow"]</a>
            </div>
        }
        else
        {
            <p class="eyebrow">@Localizer["PersonalData"]</p>
            <h2>@Localizer["StartHere"]</h2>
            <EditForm Model="Model" OnValidSubmit="RegisterAsync" FormName="donor-registration">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="tenant">@Localizer["Organization"]</label>
                    <select id="tenant" @bind="SelectedTenantId">
                        @foreach (var tenant in TenantCatalog.All)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="name">@Localizer["FullName"]</label>
                    <InputText id="name" autocomplete="name" @bind-Value="Model.FullName" />
                    <ValidationMessage For="() => Model.FullName" />
                </div>
                <div class="form-field">
                    <label for="email">E-mail</label>
                    <InputText id="email" type="email" autocomplete="email" @bind-Value="Model.Email" />
                    <ValidationMessage For="() => Model.Email" />
                </div>
                <div class="form-field">
                    <label for="cpf">CPF</label>
                    <InputText id="cpf" inputmode="numeric" autocomplete="off" @bind-Value="Model.Cpf" />
                    <ValidationMessage For="() => Model.Cpf" />
                </div>
                <div class="form-field">
                    <label for="password">@Localizer["Password"]</label>
                    <InputText id="password" type="password" autocomplete="new-password" @bind-Value="Model.Password" />
                    <ValidationMessage For="() => Model.Password" />
                    <small>@Localizer["PasswordRequirements"]</small>
                </div>
                <label class="consent-field">
                    <InputCheckbox @bind-Value="Model.Consent" />
                    <span>@Localizer["DataConsent"]</span>
                </label>
                <ValidationMessage For="() => Model.Consent" />
                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="notice notice-error">@Error</div>
                }
                <button class="button button-primary button-full" type="submit" disabled="@Submitting">@(Submitting ? Localizer["CreatingAccount"] : Localizer["CreateAccount"])</button>
            </EditForm>
            <p class="access-security">@Localizer["AlreadyHaveAccount"] <a href="/account/login?returnUrl=/">@Localizer["SignIn"]</a></p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "tenant")] public string? TenantId { get; set; }

    private RegistrationModel Model { get; set; } = new();
    private string SelectedTenantId { get; set; } = "esperanca-solidaria";
    private TenantBrand Tenant => TenantCatalog.Resolve(SelectedTenantId);
    private string Error { get; set; } = string.Empty;
    private bool Submitting { get; set; }
    private bool Completed { get; set; }

    protected override void OnParametersSet()
    {
        SelectedTenantId = TenantCatalog.Resolve(TenantId).Id;
    }

    private async Task RegisterAsync()
    {
        if (!Model.Consent)
        {
            Error = Localizer["ConsentRequired"];
            return;
        }

        Submitting = true;
        Error = string.Empty;
        try
        {
            await Api.RegisterDonorAsync(
                Tenant.Id,
                new DonorRegistrationRequest(Model.FullName, Model.Email, Model.Cpf, Model.Password),
                CancellationToken.None);
            Completed = true;
        }
        catch (SolidariaApiException exception)
        {
            Error = exception.StatusCode == System.Net.HttpStatusCode.Conflict
                ? Localizer["EmailAlreadyRegistered"]
                : Localizer["RegistrationError"];
        }
        finally
        {
            Submitting = false;
        }
    }

    private sealed class RegistrationModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.FullNameRequired))]
        [StringLength(120, MinimumLength = 3, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.FullNameInvalid))]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.EmailRequired))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.EmailInvalid))]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CpfRequired))]
        [StringLength(14, MinimumLength = 11, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.CpfInvalid))]
        public string Cpf { get; set; } = string.Empty;

        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.PasswordRequired))]
        [MinLength(10, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.PasswordLength))]
        public string Password { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.ConsentRequired))]
        public bool Consent { get; set; }
    }
}
