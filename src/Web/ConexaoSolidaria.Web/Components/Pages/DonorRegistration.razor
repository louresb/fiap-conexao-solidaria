@page "/cadastro"
@using System.ComponentModel.DataAnnotations
@using ConexaoSolidaria.Contracts.Identity
@inject SolidariaApiClient Api

<PageTitle>Cadastro de doador | Conexão Solidária</PageTitle>

<section class="registration-page">
    <div class="registration-intro @Tenant.AccentClass">
        <p class="eyebrow">@Tenant.Name</p>
        <h1>Crie sua conta de doador.</h1>
        <p>Uma conta permite contribuir com segurança e acompanhar cada etapa do processamento.</p>
        <div class="registration-benefits">
            <span>Identidade protegida</span>
            <span>Histórico por organização</span>
            <span>Consentimento transparente</span>
        </div>
    </div>
    <div class="registration-form">
        @if (Completed)
        {
            <div class="registration-success">
                <span aria-hidden="true">✓</span>
                <h2>Cadastro concluído</h2>
                <p>Sua conta foi vinculada à @Tenant.Name. Entre para escolher uma campanha.</p>
                <a class="button button-primary button-full" href="/account/login?returnUrl=@Uri.EscapeDataString($"/?tenant={Tenant.Id}")">Entrar agora</a>
            </div>
        }
        else
        {
            <p class="eyebrow">Dados pessoais</p>
            <h2>Comece por aqui</h2>
            <EditForm Model="Model" OnValidSubmit="RegisterAsync" FormName="donor-registration">
                <DataAnnotationsValidator />
                <div class="form-field">
                    <label for="tenant">Organização</label>
                    <select id="tenant" @bind="SelectedTenantId">
                        @foreach (var tenant in TenantCatalog.All)
                        {
                            <option value="@tenant.Id">@tenant.Name</option>
                        }
                    </select>
                </div>
                <div class="form-field">
                    <label for="name">Nome completo</label>
                    <InputText id="name" autocomplete="name" @bind-Value="Model.FullName" />
                    <ValidationMessage For="() => Model.FullName" />
                </div>
                <div class="form-field">
                    <label for="email">E-mail</label>
                    <InputText id="email" type="email" autocomplete="email" @bind-Value="Model.Email" />
                    <ValidationMessage For="() => Model.Email" />
                </div>
                <div class="form-field">
                    <label for="cpf">CPF</label>
                    <InputText id="cpf" inputmode="numeric" autocomplete="off" @bind-Value="Model.Cpf" />
                    <ValidationMessage For="() => Model.Cpf" />
                </div>
                <div class="form-field">
                    <label for="password">Senha</label>
                    <InputText id="password" type="password" autocomplete="new-password" @bind-Value="Model.Password" />
                    <ValidationMessage For="() => Model.Password" />
                    <small>Use ao menos 10 caracteres, com maiúscula, minúscula e número.</small>
                </div>
                <label class="consent-field">
                    <InputCheckbox @bind-Value="Model.Consent" />
                    <span>Li e concordo com o uso dos dados para cadastro, autenticação e processamento das doações.</span>
                </label>
                <ValidationMessage For="() => Model.Consent" />
                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="notice notice-error">@Error</div>
                }
                <button class="button button-primary button-full" type="submit" disabled="@Submitting">@(Submitting ? "Criando conta..." : "Criar conta")</button>
            </EditForm>
            <p class="access-security">Já tem uma conta? <a href="/account/login?returnUrl=/">Entrar</a></p>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "tenant")] public string? TenantId { get; set; }

    private RegistrationModel Model { get; set; } = new();
    private string SelectedTenantId { get; set; } = "esperanca-solidaria";
    private TenantBrand Tenant => TenantCatalog.Resolve(SelectedTenantId);
    private string Error { get; set; } = string.Empty;
    private bool Submitting { get; set; }
    private bool Completed { get; set; }

    protected override void OnParametersSet()
    {
        SelectedTenantId = TenantCatalog.Resolve(TenantId).Id;
    }

    private async Task RegisterAsync()
    {
        if (!Model.Consent)
        {
            Error = "Confirme o consentimento para continuar.";
            return;
        }

        Submitting = true;
        Error = string.Empty;
        try
        {
            await Api.RegisterDonorAsync(
                Tenant.Id,
                new DonorRegistrationRequest(Model.FullName, Model.Email, Model.Cpf, Model.Password),
                CancellationToken.None);
            Completed = true;
        }
        catch (SolidariaApiException exception)
        {
            Error = exception.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "Este e-mail já possui cadastro nesta organização."
                : "Não foi possível concluir o cadastro. Revise os dados informados.";
        }
        finally
        {
            Submitting = false;
        }
    }

    private sealed class RegistrationModel
    {
        [Required(ErrorMessage = "Informe seu nome.")]
        [StringLength(120, MinimumLength = 3, ErrorMessage = "Informe o nome completo.")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu CPF.")]
        [StringLength(14, MinimumLength = 11, ErrorMessage = "Informe um CPF válido.")]
        public string Cpf { get; set; } = string.Empty;

        [Required(ErrorMessage = "Crie uma senha.")]
        [MinLength(10, ErrorMessage = "A senha deve ter ao menos 10 caracteres.")]
        public string Password { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "O consentimento é obrigatório.")]
        public bool Consent { get; set; }
    }
}
