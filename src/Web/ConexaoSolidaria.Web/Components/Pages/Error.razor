@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["ErrorPageTitle"]</PageTitle>

<h1 class="text-danger">@Localizer["ErrorTitle"]</h1>
<h2 class="text-danger">@Localizer["ErrorDescription"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["RequestId"]:</strong> <code>@RequestId</code>
    </p>
}

<p>@Localizer["ErrorSupportDescription"]</p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
