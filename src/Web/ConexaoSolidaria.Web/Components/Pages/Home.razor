@page "/"
@using ConexaoSolidaria.Contracts.Campaigns
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["HomePageTitle", Tenant.Name]</PageTitle>

<section class="tenant-hero @Tenant.AccentClass" style="background-image: linear-gradient(90deg, rgba(10, 35, 29, .9) 0%, rgba(10, 35, 29, .7) 38%, rgba(10, 35, 29, .08) 72%), url('@Tenant.HeroImage')">
    <div class="hero-inner">
        <h1>@Tenant.Name</h1>
        <p class="hero-copy">@Localizer[$"TenantPurpose.{Tenant.Id}"]</p>
        <div class="hero-actions">
            <a class="button button-primary" href="#campanhas">@Localizer["ExploreCampaigns"]</a>
            <a class="button button-on-dark" href="/transparencia?tenant=@Tenant.Id">@Localizer["ViewTransparency"]</a>
        </div>
        <div class="hero-trust" aria-label="@Localizer["OrganizationCommitments"]">
            <span>@Localizer["TrackedImpact"]</span>
            <span>@Localizer["Accountability"]</span>
            <span>@Localizer["SecureDonation"]</span>
        </div>
    </div>
</section>

<section class="impact-band" aria-label="@Localizer["ImpactSummary"]">
    <div class="section-inner impact-grid">
        <div><strong>@Campaigns.Count</strong><span>@Localizer["ActiveCampaigns"]</span></div>
        <div><strong>@TotalRaised.ToString("C0", Culture)</strong><span>@Localizer["Raised"]</span></div>
        <div><strong>@AverageProgress.ToString("0")%</strong><span>@Localizer["AverageGoal"]</span></div>
        <div><strong>100%</strong><span>@Localizer["AuditableEvents"]</span></div>
    </div>
</section>

<section class="campaigns-section" id="campanhas">
    <div class="section-inner">
        <div class="section-heading split-heading">
            <div>
                <p class="eyebrow">@Localizer["ParticipationEyebrow"]</p>
                <h2>@Localizer["OngoingCampaigns"]</h2>
                <p>@Localizer["OngoingCampaignsDescription"]</p>
            </div>
            <div class="search-control">
                <label for="campaign-search">@Localizer["SearchCampaign"]</label>
                <div>
                    <input id="campaign-search" @bind="SearchTerm" @bind:event="oninput" placeholder="@Localizer["SearchPlaceholder"]" />
                    <button class="button button-dark" type="button" @onclick="SearchAsync" disabled="@Loading">@Localizer["Search"]</button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="notice notice-error" role="alert">@Error</div>
        }
        else if (Loading)
        {
            <div class="loading-state">@Localizer["LoadingCampaigns"]</div>
        }
        else if (DisplayCampaigns.Count == 0)
        {
            <div class="empty-state">
                <h3>@Localizer["NoCampaignFound"]</h3>
                <p>@Localizer["NoCampaignFoundDescription"]</p>
                <button class="button button-outline" type="button" @onclick="ClearSearchAsync">@Localizer["ClearSearch"]</button>
            </div>
        }
        else
        {
            <div class="campaign-grid">
                @foreach (var campaign in DisplayCampaigns)
                {
                    <CampaignCard Campaign="campaign" />
                }
            </div>
        }
    </div>
</section>

<section class="confidence-band">
    <div class="section-inner confidence-layout">
        <div>
            <p class="eyebrow">@Localizer["ConfidenceEyebrow"]</p>
            <h2>@Localizer["ConfidenceTitle"]</h2>
        </div>
        <div class="confidence-list">
            <div><strong>01</strong><span>@Localizer["PaymentConfirmed"]</span></div>
            <div><strong>02</strong><span>@Localizer["DonationProcessed"]</span></div>
            <div><strong>03</strong><span>@Localizer["AuditUpdated"]</span></div>
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "tenant")]
    public string? TenantId { get; set; }

    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private TenantBrand Tenant => TenantCatalog.Resolve(TenantId);
    private IReadOnlyList<ActiveCampaignDto> Campaigns { get; set; } = [];
    private IReadOnlyList<ActiveCampaignDto> SearchResults { get; set; } = [];
    private IReadOnlyList<ActiveCampaignDto> DisplayCampaigns => HasSearched ? SearchResults : Campaigns;
    private string SearchTerm { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;
    private bool Loading { get; set; }
    private bool HasSearched { get; set; }
    private decimal TotalRaised => Campaigns.Sum(campaign => campaign.TotalRaised);
    private decimal AverageProgress => Campaigns.Count == 0 ? 0 : Campaigns.Average(campaign => campaign.ProgressPercent);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = string.Empty;
        SearchTerm = string.Empty;
        SearchResults = [];
        HasSearched = false;
        try
        {
            Campaigns = (await Api.GetActiveCampaignsAsync(Tenant.Id, CancellationToken.None)).Items;
        }
        catch
        {
            Error = Localizer["CampaignLoadError"];
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            SearchResults = [];
            HasSearched = false;
            return;
        }

        Loading = true;
        Error = string.Empty;
        try
        {
            SearchResults = await Api.SearchCampaignsAsync(Tenant.Id, SearchTerm.Trim(), CancellationToken.None);
            HasSearched = true;
        }
        catch
        {
            Error = Localizer["SearchUnavailable"];
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        SearchTerm = string.Empty;
        SearchResults = [];
        HasSearched = false;
        await Task.CompletedTask;
    }
}
