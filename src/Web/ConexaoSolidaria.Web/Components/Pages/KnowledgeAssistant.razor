@page "/assistente"
@using ConexaoSolidaria.Contracts.Knowledge
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["AssistantPageTitle"]</PageTitle>

<section class="assistant-page @Tenant.AccentClass">
    <div class="assistant-intro">
        <p class="eyebrow">@Localizer["SourcedInformation"]</p>
        <h1>@Localizer["TalkToOrganization", Tenant.ShortName]</h1>
        <p>@Localizer["AssistantIntroduction"]</p>
        <div class="suggested-questions">
            @foreach (var suggestion in Suggestions)
            {
                <button type="button" @onclick="() => AskSuggestionAsync(suggestion)">@suggestion</button>
            }
        </div>
    </div>

    <div class="assistant-conversation" aria-live="polite">
        @if (Answer is null)
        {
            <div class="conversation-empty">
                <span aria-hidden="true">?</span>
                <strong>@Localizer["HowCanWeHelp"]</strong>
                <p>@Localizer["AskAboutOrganization"]</p>
            </div>
        }
        else
        {
            <div class="question-bubble">@LastQuestion</div>
            <div class="answer-block">
                <span class="answer-mode">@(Answer.AnswerMode == "grounded-generation" ? Localizer["GroundedAiAnswer"] : Localizer["ExtractiveAnswer"])</span>
                <p>@Answer.Answer</p>
                @if (Answer.Sources.Count > 0)
                {
                    <div class="source-list">
                        <strong>@Localizer["SourcesConsulted"]</strong>
                        @foreach (var source in Answer.Sources)
                        {
                            <details>
                                <summary>@source.Title</summary>
                                <p>@source.Excerpt</p>
                            </details>
                        }
                    </div>
                }
                <small>@Localizer["Correlation"]: @Answer.CorrelationId</small>
            </div>
        }

        <div class="assistant-composer">
            <label for="knowledge-question">@Localizer["YourQuestion"]</label>
            <textarea id="knowledge-question" @bind="Question" placeholder="@Localizer["QuestionPlaceholder"]"></textarea>
            <button class="button button-primary" type="button" @onclick="AskAsync" disabled="@Loading">@(Loading ? Localizer["ConsultingSources"] : Localizer["SendQuestion"])</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="notice notice-error">@Error</div>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "tenant")] public string? TenantId { get; set; }

    private string[] Suggestions =>
    [
        Localizer["Suggestion.Accountability"],
        Localizer["Suggestion.PublicData"],
        Localizer["Suggestion.DonationConfirmation"]
    ];

    private TenantBrand Tenant => TenantCatalog.Resolve(TenantId);
    private string Question { get; set; } = string.Empty;
    private string LastQuestion { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;
    private bool Loading { get; set; }
    private KnowledgeAnswerDto? Answer { get; set; }

    private async Task AskSuggestionAsync(string suggestion)
    {
        Question = suggestion;
        await AskAsync();
    }

    private async Task AskAsync()
    {
        if (Question.Trim().Length < 5)
        {
            Error = Localizer["QuestionTooShort"];
            return;
        }

        Loading = true;
        Error = string.Empty;
        try
        {
            LastQuestion = Question.Trim();
            Answer = await Api.AskKnowledgeAsync(Tenant.Id, LastQuestion, CancellationToken.None);
            Question = string.Empty;
        }
        catch
        {
            Error = Localizer["AssistantUnavailable"];
        }
        finally
        {
            Loading = false;
        }
    }
}
