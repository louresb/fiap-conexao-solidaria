@page "/gestao"
@attribute [Authorize(Roles = "GestorONG")]
@using ConexaoSolidaria.Contracts.Audit
@using ConexaoSolidaria.Contracts.Campaigns
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["ManagementPageTitle"]</PageTitle>

<section class="management-heading">
    <div class="section-inner split-heading">
        <div>
            <p class="eyebrow">@Localizer["OrganizationDashboard"]</p>
            <h1>@Localizer["Overview"]</h1>
            <p>@Localizer["UpdatedOperationIndicators", Tenant.Name]</p>
        </div>
        <a class="button button-primary" href="/gestao/campanhas/nova">@Localizer["NewCampaign"]</a>
    </div>
</section>

<section class="section-inner management-page">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error">@Error</div>
    }

    <div class="management-metrics">
        <div><span>@Localizer["ActiveFundraising"]</span><strong>@ActiveCampaigns.Sum(c => c.TotalRaised).ToString("C0", Culture)</strong><small>@Localizer["CampaignCount", ActiveCampaigns.Count]</small></div>
        <div><span>@Localizer["ConsolidatedGoal"]</span><strong>@ActiveCampaigns.Sum(c => c.GoalAmount).ToString("C0", Culture)</strong><small>@Localizer["PercentReached", Progress.ToString("0", Culture)]</small></div>
        <div><span>@Localizer["RecentEvents"]</span><strong>@AuditEvents.Count</strong><small>@Localizer["LatestRecords"]</small></div>
        <div><span>@Localizer["OperationalHealth"]</span><strong class="healthy-value">@Localizer["Operating"]</strong><small>@Localizer["AvailableFlows"]</small></div>
    </div>

    <div class="management-grid">
        <section class="management-section campaigns-overview">
            <div class="section-heading split-heading compact-heading">
                <div><p class="eyebrow">@Localizer["Portfolio"]</p><h2>@Localizer["Campaigns"]</h2></div>
                <a class="text-link" href="/gestao/campanhas">@Localizer["ManageAll"]</a>
            </div>
            <div class="management-campaign-list">
                @foreach (var campaign in Campaigns.Take(5))
                {
                    <article>
                        <div><strong>@campaign.Title</strong><span>@StatusLabel(campaign.Status)</span></div>
                        <div class="progress-track"><span style="width:@ProgressOf(campaign).ToString("0.##", Invariant)%"></span></div>
                        <b>@campaign.TotalRaised.ToString("C0", Culture) / @campaign.GoalAmount.ToString("C0", Culture)</b>
                    </article>
                }
            </div>
        </section>

        <section class="management-section event-overview">
            <div class="section-heading split-heading compact-heading">
                <div><p class="eyebrow">@Localizer["Traceability"]</p><h2>@Localizer["RecentActivity"]</h2></div>
                <a class="text-link" href="/gestao/auditoria">@Localizer["OpenAudit"]</a>
            </div>
            <div class="event-stream">
                @foreach (var item in AuditEvents.Take(6))
                {
                    <div>
                        <span class="event-dot"></span>
                        <p><strong>@EventLabel(item.EventType)</strong><small>@item.Source · @item.Timestamp.LocalDateTime.ToString("dd/MM HH:mm")</small></p>
                    </div>
                }
                @if (AuditEvents.Count == 0)
                {
                    <p class="muted">@Localizer["FutureEventsNotice"]</p>
                }
            </div>
        </section>
    </div>
</section>

@code {
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private static readonly System.Globalization.CultureInfo Invariant = System.Globalization.CultureInfo.InvariantCulture;
    private UserApiContext User { get; set; } = new(false, "", "", "", "", false, false);
    private TenantBrand Tenant => TenantCatalog.Resolve(User.TenantId);
    private IReadOnlyList<CampaignDto> Campaigns { get; set; } = [];
    private IReadOnlyList<CampaignDto> ActiveCampaigns => Campaigns.Where(c => c.Status == CampaignStatus.Ativa).ToList();
    private IReadOnlyList<AuditEventDto> AuditEvents { get; set; } = [];
    private string Error { get; set; } = string.Empty;
    private decimal Progress => ActiveCampaigns.Sum(c => c.GoalAmount) <= 0 ? 0 : ActiveCampaigns.Sum(c => c.TotalRaised) / ActiveCampaigns.Sum(c => c.GoalAmount) * 100;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User = await Api.GetUserContextAsync();
            Campaigns = await Api.GetManagedCampaignsAsync(CancellationToken.None);
            AuditEvents = await Api.GetAuditAsync(12, CancellationToken.None);
        }
        catch
        {
            Error = Localizer["ManagementIndicatorsError"];
        }
    }

    private static decimal ProgressOf(CampaignDto campaign) => campaign.GoalAmount <= 0 ? 0 : Math.Min(campaign.TotalRaised / campaign.GoalAmount * 100, 100);
    private string StatusLabel(CampaignStatus status) => status switch
    {
        CampaignStatus.Rascunho => Localizer["StatusDraft"],
        CampaignStatus.EmRevisao => Localizer["StatusInReview"],
        CampaignStatus.Aprovada => Localizer["StatusApproved"],
        CampaignStatus.Ativa => Localizer["StatusPublished"],
        CampaignStatus.Concluida => Localizer["StatusCompleted"],
        CampaignStatus.Cancelada => Localizer["StatusCancelled"],
        _ => status.ToString()
    };
    private string EventLabel(string eventType) => eventType switch
    {
        "DonationIntentCreated" => Localizer["Event.DonationIntentCreated"],
        "PaymentConfirmed" => Localizer["Event.PaymentConfirmed"],
        "DonationProcessed" => Localizer["Event.DonationProcessed"],
        "CampaignCreated" => Localizer["Event.CampaignCreated"],
        "CampaignPublished" => Localizer["Event.CampaignPublished"],
        "CampaignUpdated" => Localizer["Event.CampaignUpdated"],
        "CampaignCancelled" => Localizer["Event.CampaignCancelled"],
        _ => eventType
    };
}
