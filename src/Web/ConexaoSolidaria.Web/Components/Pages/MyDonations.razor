@page "/minhas-doacoes"
@attribute [Authorize(Roles = "Doador")]
@using ConexaoSolidaria.Contracts.Donations
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["MyDonationsPageTitle"]</PageTitle>

<section class="page-heading donor-heading @Tenant.AccentClass">
    <div class="section-inner">
        <p class="eyebrow">@Localizer["DonorArea"]</p>
        <h1>@Localizer["YourImpactTitle"]</h1>
        <p>@Localizer["PrivateDonationHistoryDescription", Tenant.Name]</p>
    </div>
</section>

<section class="section-inner donor-page">
    @if (Loading)
    {
        <div class="page-loading">@Localizer["LoadingContributions"]</div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error" role="alert">@Error</div>
    }
    else
    {
        <div class="donor-metrics" aria-label="@Localizer["DonationSummary"]">
            <div><span>@Localizer["ConfirmedTotal"]</span><strong>@ConfirmedTotal.ToString("C2", Culture)</strong><small>@Localizer["ImpactAlreadyProcessed"]</small></div>
            <div><span>@Localizer["SupportedCampaigns"]</span><strong>@SupportedCampaigns</strong><small>@Localizer["DifferentInitiatives"]</small></div>
            <div><span>@Localizer["Contributions"]</span><strong>@ConfirmedCount</strong><small>@Localizer["ConfirmedPayments"]</small></div>
            <div><span>@Localizer["Processing"]</span><strong>@PendingCount</strong><small>@Localizer["AwaitingConfirmation"]</small></div>
        </div>

        <div class="donor-history-heading split-heading">
            <div>
                <p class="eyebrow">@Localizer["PrivateHistory"]</p>
                <h2>@Localizer["MyContributions"]</h2>
            </div>
            <a class="button button-primary" href="/?tenant=@Tenant.Id">@Localizer["SupportAnotherCampaign"]</a>
        </div>

        @if (Donations.Count == 0)
        {
            <div class="empty-state donor-empty">
                <h3>@Localizer["FirstImpactTitle"]</h3>
                <p>@Localizer["FirstImpactDescription"]</p>
                <a class="button button-dark" href="/?tenant=@Tenant.Id">@Localizer["ExploreCampaigns"]</a>
            </div>
        }
        else
        {
            <div class="donor-history-list">
                @foreach (var donation in Donations)
                {
                    <article>
                        <div class="donation-status-mark @StatusClass(donation.Status)" aria-hidden="true">@StatusInitial(donation.Status)</div>
                        <div class="donation-main">
                            <span>@donation.CreatedAtUtc.LocalDateTime.ToString("D", Culture)</span>
                            <h3>@donation.CampaignTitle</h3>
                            <small>@PaymentMethodLabel(donation.PaymentMethod) · @Localizer["Reference"].Value.ToLower(Culture) @donation.Id.ToString()[..8].ToUpperInvariant()</small>
                        </div>
                        <div class="donation-value">
                            <strong>@donation.Amount.ToString("C2", Culture)</strong>
                            <span class="status-badge @StatusClass(donation.Status)">@StatusLabel(donation.Status)</span>
                        </div>
                    </article>
                }
            </div>
        }

        <aside class="donor-privacy-note">
            <strong>@Localizer["PrivacyByDefault"]</strong>
            <p>@Localizer["DonorPrivacyDescription"]</p>
        </aside>
    }
</section>

@code {
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private UserApiContext User { get; set; } = new(false, "", "", "", "", false, false);
    private TenantBrand Tenant => TenantCatalog.Resolve(User.TenantId);
    private IReadOnlyList<DonationDto> Donations { get; set; } = [];
    private bool Loading { get; set; } = true;
    private string Error { get; set; } = string.Empty;
    private decimal ConfirmedTotal => Donations.Where(IsConfirmed).Sum(item => item.Amount);
    private int ConfirmedCount => Donations.Count(IsConfirmed);
    private int PendingCount => Donations.Count(item => item.Status == "PendingPayment");
    private int SupportedCampaigns => Donations.Where(IsConfirmed).Select(item => item.CampaignId).Distinct().Count();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            User = await Api.GetUserContextAsync();
            Donations = await Api.GetMyDonationsAsync(CancellationToken.None);
        }
        catch
        {
            Error = Localizer["DonationHistoryError"];
        }
        finally
        {
            Loading = false;
        }
    }

    private static bool IsConfirmed(DonationDto donation) => donation.Status == "Confirmed";
    private static string StatusInitial(string status) => status == "Confirmed" ? "✓" : status == "Rejected" ? "!" : "·";
    private static string StatusClass(string status) => status switch
    {
        "Confirmed" => "donation-confirmed",
        "Rejected" => "donation-rejected",
        _ => "donation-pending"
    };
    private string StatusLabel(string status) => status switch
    {
        "Confirmed" => Localizer["StatusConfirmed"],
        "Rejected" => Localizer["StatusNotCompleted"],
        _ => Localizer["StatusProcessing"]
    };
    private string PaymentMethodLabel(string paymentMethod) => paymentMethod switch
    {
        "credit_card" => Localizer["CreditCard"],
        "bank_slip" => Localizer["BankSlip"],
        _ => "Pix"
    };
}
