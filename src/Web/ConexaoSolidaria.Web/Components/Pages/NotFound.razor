@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["NotFoundPageTitle"]</PageTitle>

<section class="narrow-page empty-state">
    <h1>@Localizer["NotFoundTitle"]</h1>
    <p>@Localizer["NotFoundDescription"]</p>
    <a class="button button-dark" href="/">@Localizer["BackHome"]</a>
</section>
