@page "/administracao"
@attribute [Authorize(Roles = "AdminSaaS")]
@inject SolidariaApiClient Api

<PageTitle>Administração | Conexão Solidária</PageTitle>

<section class="page-heading tenant-platform">
    <div class="section-inner">
        <p class="eyebrow">Administração SaaS</p>
        <h1>Visão operacional da plataforma.</h1>
        <p>Saúde dos serviços e alcance dos tenants em uma leitura única, sem expor dados pessoais.</p>
    </div>
</section>

<section class="section-inner platform-admin">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error" role="alert">@Error</div>
    }
    else if (Loading)
    {
        <div class="notice">Consolidando o estado da plataforma...</div>
    }
    else
    {
        <div class="management-metrics">
            <div><span>Tenants ativos</span><strong>@Tenants.Count</strong><small>catálogo compartilhado</small></div>
            <div><span>Campanhas publicadas</span><strong>@Tenants.Sum(t => t.CampaignCount)</strong><small>isoladas por tenant</small></div>
            <div><span>Total mobilizado</span><strong>@Tenants.Sum(t => t.TotalRaised).ToString("C0", Culture)</strong><small>visão agregada</small></div>
            <div><span>Serviços saudáveis</span><strong>@HealthyServices/@Health.Dependencies.Count</strong><small>@Health.Status</small></div>
        </div>

        <div class="platform-admin-grid">
            <section aria-labelledby="tenant-overview-title">
                <div class="section-heading">
                    <p class="eyebrow">Multi-tenancy</p>
                    <h2 id="tenant-overview-title">Organizações atendidas</h2>
                </div>
                <div class="tenant-admin-list">
                    @foreach (var tenant in Tenants)
                    {
                        <article>
                            <span class="tenant-admin-mark @tenant.Brand.AccentClass">@tenant.Brand.ShortName[..1]</span>
                            <div>
                                <strong>@tenant.Brand.Name</strong>
                                <small>@tenant.Brand.Location</small>
                            </div>
                            <dl>
                                <div><dt>Campanhas</dt><dd>@tenant.CampaignCount</dd></div>
                                <div><dt>Mobilizado</dt><dd>@tenant.TotalRaised.ToString("C0", Culture)</dd></div>
                            </dl>
                        </article>
                    }
                </div>
            </section>

            <aside class="service-health" aria-labelledby="service-health-title">
                <div class="section-heading">
                    <p class="eyebrow">Operação</p>
                    <h2 id="service-health-title">Dependências críticas</h2>
                </div>
                <ul>
                    @foreach (var dependency in Health.Dependencies.OrderBy(d => d.Name))
                    {
                        <li>
                            <span class="health-dot @(dependency.Healthy ? "healthy" : "unhealthy")" aria-hidden="true"></span>
                            <strong>@ServiceLabel(dependency.Name)</strong>
                            <small>@(dependency.Healthy ? "Disponível" : "Indisponível")</small>
                        </li>
                    }
                </ul>
            </aside>
        </div>
    }
</section>

@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private bool Loading { get; set; } = true;
    private string Error { get; set; } = string.Empty;
    private PlatformHealthDto Health { get; set; } = new("Unknown", []);
    private IReadOnlyList<TenantOverview> Tenants { get; set; } = [];
    private int HealthyServices => Health.Dependencies.Count(d => d.Healthy);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var healthTask = Api.GetPlatformHealthAsync(CancellationToken.None);
            var tenantTasks = TenantCatalog.All.Select(async tenant =>
            {
                var campaigns = await Api.GetActiveCampaignsAsync(tenant.Id, CancellationToken.None);
                return new TenantOverview(
                    tenant,
                    campaigns.Items.Count,
                    campaigns.Items.Sum(c => c.TotalRaised));
            }).ToArray();

            await Task.WhenAll(tenantTasks.Append((Task)healthTask));
            Health = await healthTask;
            Tenants = await Task.WhenAll(tenantTasks);
        }
        catch
        {
            Error = "Não foi possível consolidar o estado operacional da plataforma.";
        }
        finally
        {
            Loading = false;
        }
    }

    private static string ServiceLabel(string name) => name switch
    {
        "identity" => "Identidade",
        "campaigns" => "Campanhas",
        "donations" => "Doações",
        "payments" => "Pagamentos",
        "audit" => "Auditoria",
        "knowledge" => "Conhecimento",
        _ => name
    };

    private sealed record TenantOverview(TenantBrand Brand, int CampaignCount, decimal TotalRaised);
}
