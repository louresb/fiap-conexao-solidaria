@page "/administracao"
@attribute [Authorize(Roles = "AdminSaaS")]
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["PlatformAdministrationPageTitle"]</PageTitle>

<section class="page-heading tenant-platform">
    <div class="section-inner">
        <p class="eyebrow">@Localizer["SaasAdministration"]</p>
        <h1>@Localizer["PlatformOperationalView"]</h1>
        <p>@Localizer["PlatformOperationalDescription"]</p>
    </div>
</section>

<section class="section-inner platform-admin">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error" role="alert">@Error</div>
    }
    else if (Loading)
    {
        <div class="notice">@Localizer["ConsolidatingPlatformState"]</div>
    }
    else
    {
        <div class="management-metrics">
            <div><span>@Localizer["ActiveTenants"]</span><strong>@Tenants.Count</strong><small>@Localizer["SharedCatalog"]</small></div>
            <div><span>@Localizer["PublishedCampaigns"]</span><strong>@Tenants.Sum(t => t.CampaignCount)</strong><small>@Localizer["IsolatedByTenant"]</small></div>
            <div><span>@Localizer["TotalMobilized"]</span><strong>@Tenants.Sum(t => t.TotalRaised).ToString("C0", Culture)</strong><small>@Localizer["AggregatedView"]</small></div>
            <div><span>@Localizer["HealthyServices"]</span><strong>@HealthyServices/@Health.Dependencies.Count</strong><small>@Localizer[$"HealthStatus.{Health.Status}"]</small></div>
        </div>

        <div class="platform-admin-grid">
            <section aria-labelledby="tenant-overview-title">
                <div class="section-heading">
                    <p class="eyebrow">Multi-tenancy</p>
                    <h2 id="tenant-overview-title">@Localizer["ServedOrganizations"]</h2>
                </div>
                <div class="tenant-admin-list">
                    @foreach (var tenant in Tenants)
                    {
                        <article>
                            <span class="tenant-admin-mark @tenant.Brand.AccentClass">@tenant.Brand.ShortName[..1]</span>
                            <div>
                                <strong>@tenant.Brand.Name</strong>
                            </div>
                            <dl>
                                <div><dt>@Localizer["Campaigns"]</dt><dd>@tenant.CampaignCount</dd></div>
                                <div><dt>@Localizer["Mobilized"]</dt><dd>@tenant.TotalRaised.ToString("C0", Culture)</dd></div>
                            </dl>
                        </article>
                    }
                </div>
            </section>

            <aside class="service-health" aria-labelledby="service-health-title">
                <div class="section-heading">
                    <p class="eyebrow">@Localizer["Operation"]</p>
                    <h2 id="service-health-title">@Localizer["CriticalDependencies"]</h2>
                </div>
                <ul>
                    @foreach (var dependency in Health.Dependencies.OrderBy(d => d.Name))
                    {
                        <li>
                            <span class="health-dot @(dependency.Healthy ? "healthy" : "unhealthy")" aria-hidden="true"></span>
                            <strong>@ServiceLabel(dependency.Name)</strong>
                            <small>@(dependency.Healthy ? Localizer["Available"] : Localizer["Unavailable"])</small>
                        </li>
                    }
                </ul>
            </aside>
        </div>
    }
</section>

@code {
    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private bool Loading { get; set; } = true;
    private string Error { get; set; } = string.Empty;
    private PlatformHealthDto Health { get; set; } = new("Unknown", []);
    private IReadOnlyList<TenantOverview> Tenants { get; set; } = [];
    private int HealthyServices => Health.Dependencies.Count(d => d.Healthy);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var healthTask = Api.GetPlatformHealthAsync(CancellationToken.None);
            var tenantTasks = TenantCatalog.All.Select(async tenant =>
            {
                var campaigns = await Api.GetActiveCampaignsAsync(tenant.Id, CancellationToken.None);
                return new TenantOverview(
                    tenant,
                    campaigns.Items.Count,
                    campaigns.Items.Sum(c => c.TotalRaised));
            }).ToArray();

            await Task.WhenAll(tenantTasks.Append((Task)healthTask));
            Health = await healthTask;
            Tenants = await Task.WhenAll(tenantTasks);
        }
        catch
        {
            Error = Localizer["PlatformStateError"];
        }
        finally
        {
            Loading = false;
        }
    }

    private string ServiceLabel(string name) => name switch
    {
        "identity" => Localizer["Service.Identity"],
        "campaigns" => Localizer["Service.Campaigns"],
        "donations" => Localizer["Service.Donations"],
        "payments" => Localizer["Service.Payments"],
        "audit" => Localizer["Service.Audit"],
        "knowledge" => Localizer["Service.Knowledge"],
        _ => name
    };

    private sealed record TenantOverview(TenantBrand Brand, int CampaignCount, decimal TotalRaised);
}
