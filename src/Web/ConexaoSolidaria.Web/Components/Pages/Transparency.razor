@page "/transparencia"
@using ConexaoSolidaria.Contracts.Campaigns
@inject SolidariaApiClient Api
@inject IStringLocalizer<WebResources> Localizer

<PageTitle>@Localizer["TransparencyPageTitle"]</PageTitle>

<section class="page-heading @Tenant.AccentClass">
    <div class="section-inner">
        <p class="eyebrow">@Tenant.Name</p>
        <h1>@Localizer["TransparencyTitle"]</h1>
        <p>@Localizer["TransparencyDescription"]</p>
    </div>
</section>

<section class="section-inner transparency-page">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice notice-error">@Error</div>
    }
    else
    {
        <div class="transparency-metrics">
            <div><span>@Localizer["TotalMobilized"]</span><strong>@Snapshot.TotalRaised.ToString("C0", Culture)</strong><small>@Localizer["InActiveCampaigns"]</small></div>
            <div><span>@Localizer["PublishedGoals"]</span><strong>@Snapshot.PublishedGoal.ToString("C0", Culture)</strong><small>@Localizer["WithDefinedDeadline"]</small></div>
            <div><span>@Localizer["AverageProgress"]</span><strong>@Snapshot.AverageProgress.ToString("0", Culture)%</strong><small>@Localizer["ContinuousUpdates"]</small></div>
            <div><span>@Localizer["Campaigns"]</span><strong>@Snapshot.ActiveCampaigns</strong><small>@Localizer["OpenForContributions"]</small></div>
        </div>

        <section class="transparency-history" aria-labelledby="donation-history-title">
            <div class="section-heading">
                <p class="eyebrow">@Localizer["PublicHistory"]</p>
                <h2 id="donation-history-title">@Localizer["ConfirmedContributions"]</h2>
                <p>@Localizer["ConfirmedContributionsDescription"]</p>
            </div>
            @if (Snapshot.RecentDonations.Count == 0)
            {
                <div class="notice">@Localizer["FutureContributionsNotice"]</div>
            }
            else
            {
                <div class="transparency-table-wrap">
                    <table class="data-table">
                        <thead><tr><th>@Localizer["Confirmation"]</th><th>@Localizer["Campaign"]</th><th>@Localizer["Identification"]</th><th>@Localizer["Amount"]</th></tr></thead>
                        <tbody>
                            @foreach (var donation in Snapshot.RecentDonations)
                            {
                                <tr>
                                    <td>@donation.ProcessedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm", Culture)</td>
                                    <td><a href="/campanhas/@donation.CampaignId?tenant=@Tenant.Id">@donation.CampaignTitle</a></td>
                                    <td>@Localizer["AnonymousDonation"]</td>
                                    <td><strong>@donation.Amount.ToString("C2", Culture)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="transparency-layout">
            <div class="transparency-table-wrap">
                <div class="section-heading">
                    <p class="eyebrow">@Localizer["FinancialProgress"]</p>
                    <h2>@Localizer["FundsByCampaign"]</h2>
                </div>
                <table class="data-table">
                    <thead><tr><th>@Localizer["Campaign"]</th><th>@Localizer["RaisedTitle"]</th><th>@Localizer["Goal"]</th><th>@Localizer["Progress"]</th></tr></thead>
                    <tbody>
                        @foreach (var campaign in Campaigns.OrderByDescending(c => c.TotalRaised))
                        {
                            <tr>
                                <td><a href="/campanhas/@campaign.Id?tenant=@Tenant.Id">@campaign.Title</a></td>
                                <td>@campaign.TotalRaised.ToString("C0", Culture)</td>
                                <td>@campaign.GoalAmount.ToString("C0", Culture)</td>
                                <td><span class="table-progress"><i style="width:@Math.Min(campaign.ProgressPercent, 100).ToString("0.##", Invariant)%"></i></span><strong>@campaign.ProgressPercent.ToString("0")%</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <aside class="transparency-principles">
                <p class="eyebrow">@Localizer["HowWeProtectData"]</p>
                <h2>@Localizer["VerifiableTrail"]</h2>
                <ol>
                    <li><strong>@Localizer["Record"]</strong><span>@Localizer["RecordDescription"]</span></li>
                    <li><strong>@Localizer["Confirmation"]</strong><span>@Localizer["ConfirmationDescription"]</span></li>
                    <li><strong>@Localizer["Audit"]</strong><span>@Localizer["AuditDescription"]</span></li>
                </ol>
                <details class="technical-detail">
                    <summary>@Localizer["DataUpdates"]</summary>
                    <p>@Localizer["CacheStatusDescription", CacheStatus]</p>
                </details>
            </aside>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "tenant")] public string? TenantId { get; set; }

    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private static readonly System.Globalization.CultureInfo Invariant = System.Globalization.CultureInfo.InvariantCulture;
    private TenantBrand Tenant => TenantCatalog.Resolve(TenantId);
    private IReadOnlyList<ActiveCampaignDto> Campaigns { get; set; } = [];
    private TransparencySnapshotDto Snapshot { get; set; } = new(
        string.Empty,
        0,
        0,
        0,
        0,
        [],
        DateTimeOffset.MinValue);
    private string CacheStatus { get; set; } = "-";
    private string Error { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var campaignsTask = Api.GetActiveCampaignsAsync(Tenant.Id, CancellationToken.None);
            var transparencyTask = Api.GetTransparencyAsync(Tenant.Id, CancellationToken.None);
            await Task.WhenAll(campaignsTask, transparencyTask);
            var collection = await campaignsTask;
            Campaigns = collection.Items;
            CacheStatus = collection.CacheStatus;
            Snapshot = await transparencyTask;
        }
        catch
        {
            Error = Localizer["TransparencyLoadError"];
        }
    }
}
