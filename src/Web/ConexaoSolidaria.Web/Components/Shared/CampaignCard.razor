@using ConexaoSolidaria.Contracts.Campaigns
@inject IStringLocalizer<WebResources> Localizer

<article class="campaign-card">
    <a class="campaign-image" href="/campanhas/@Campaign.Id?tenant=@Campaign.TenantId" aria-label="@Localizer["ViewCampaignAria", Campaign.Title]">
        <img src="@Presentation.Image" alt="" loading="lazy" />
        <span>@Localizer[$"Category.{Presentation.Category}"]</span>
    </a>
    <div class="campaign-body">
        <div>
            <p class="card-kicker">@Localizer["DaysToContribute", DaysRemaining]</p>
            <h3><a href="/campanhas/@Campaign.Id?tenant=@Campaign.TenantId">@Campaign.Title</a></h3>
            <p>@Description</p>
        </div>
        <div class="campaign-progress" aria-label="@Localizer["ProgressAria", Campaign.ProgressPercent.ToString("0", Culture)]">
            <div class="progress-track"><span style="width:@Math.Min(Campaign.ProgressPercent, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
            <div class="progress-numbers">
                <strong>@Campaign.TotalRaised.ToString("C0", Culture)</strong>
                <span>@Localizer["GoalOf", Campaign.GoalAmount.ToString("C0", Culture)]</span>
            </div>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ActiveCampaignDto Campaign { get; set; } = default!;

    private System.Globalization.CultureInfo Culture => System.Globalization.CultureInfo.CurrentCulture;
    private CampaignPresentation Presentation => CampaignPresentations.For(Campaign);
    private string Description => Presentation.DescriptionResourceKey is null
        ? Campaign.Description
        : Localizer[Presentation.DescriptionResourceKey];
    private int DaysRemaining => Math.Max(0, Campaign.EndDate.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber);
}
